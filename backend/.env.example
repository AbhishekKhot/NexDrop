# ============================================================
#  NexDrop Backend Agent — Environment Variables
#  Copy to .env for local development.
# ============================================================

# ── Ports ─────────────────────────────────────────────────────────────
TCP_PORT=4000
WS_API_PORT=4001

# ── Device ────────────────────────────────────────────────────────────
# Name shown in peer lists. Defaults to OS hostname if unset.
DEVICE_NAME=My-NexDrop-Node

# ── Security ──────────────────────────────────────────────────────────
# Allow WebSocket connections from non-localhost origins.
# Keep false in production unless routing through a trusted reverse proxy.
ALLOW_REMOTE_WS=false

# Allowed CORS origin for the WS API bridge.
# Set to your frontend URL in production (e.g. https://nexdrop.example.com).
WS_ALLOWED_ORIGIN=http://localhost:5173

# ── File Storage ──────────────────────────────────────────────────────
# Directory where received files are saved (LAN mode only).
# In Docker this maps to the 'downloads' named volume.
DOWNLOAD_DIR=/downloads/NexDrop

# ── Remote Relay (run via `npm run relay` / `npm run relay:dev`) ───────
# Standalone Remote-mode relay — deployed separately from the LAN agent.
# See docs/RELAY_PROTOCOL.md and (forthcoming) deploy/ for production setup.
RELAY_PORT=4002
# Bind 127.0.0.1 behind a TLS proxy (prod); 0.0.0.0 inside a container.
RELAY_BIND_HOST=127.0.0.1
# Comma-separated Origin allow-list checked on WS upgrade (CSWSH defence).
RELAY_ALLOWED_ORIGIN=http://localhost:5173
# Trust X-Forwarded-For for client IP ONLY behind a known proxy.
RELAY_TRUST_PROXY=false
# Global max file size in bytes (default 5 GiB).
RELAY_MAX_FILE_SIZE=5368709120
RELAY_MAX_CONN_PER_IP=5
RELAY_MAX_MSG_PER_SEC=20
RELAY_MAX_FAILED_JOINS=10
RELAY_FAILED_JOIN_WINDOW_MS=60000
RELAY_ROOM_TTL_MS=600000
RELAY_ROOM_ABSOLUTE_TTL_MS=1800000
