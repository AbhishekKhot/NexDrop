# ============================================================
#  NexDrop Backend Agent — Environment Variables
#  Copy to .env for local development.
# ============================================================

# ── Ports ─────────────────────────────────────────────────────────────
TCP_PORT=4000
WS_API_PORT=4001
SIGNALING_PORT=4002

# ── Device ────────────────────────────────────────────────────────────
# Name shown in peer lists. Defaults to OS hostname if unset.
DEVICE_NAME=My-NexDrop-Node

# ── Security ──────────────────────────────────────────────────────────
# Allow WebSocket connections from non-localhost origins.
# Keep false in production unless routing through a trusted reverse proxy.
ALLOW_REMOTE_WS=false

# Allowed CORS origin for the WS API bridge.
# Set to your frontend URL in production (e.g. https://nexdrop.example.com).
WS_ALLOWED_ORIGIN=http://localhost:5173

# ── File Storage ──────────────────────────────────────────────────────
# Directory where received files are saved.
# In Docker this maps to the 'downloads' named volume.
DOWNLOAD_DIR=/downloads/NexDrop
