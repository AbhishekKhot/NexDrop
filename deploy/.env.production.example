# ============================================================
#  NexDrop Relay — Production Environment
#  Copy to /opt/nexdrop/backend/.env and edit. NEVER commit the real .env.
#  systemd reads this via EnvironmentFile (simple KEY=VALUE, # comments ok).
# ============================================================

NODE_ENV=production

# Relay listens on loopback only — Caddy (port 443) is the public face.
RELAY_PORT=4002
RELAY_BIND_HOST=127.0.0.1

# Origin allow-list — set to your FRONTEND's HTTPS origin(s), comma-separated.
# A request whose Origin is not listed is refused at the WS upgrade.
RELAY_ALLOWED_ORIGIN=https://nexdrop.example.com

# Caddy sets X-Forwarded-For; trust it so rate limiting sees the real client IP.
# Only ever true behind a trusted proxy.
RELAY_TRUST_PROXY=true

# Global hard cap (bytes). 5 GiB default.
RELAY_MAX_FILE_SIZE=5368709120

# Abuse / resource bounds.
RELAY_MAX_CONN_PER_IP=5
RELAY_MAX_MSG_PER_SEC=20
RELAY_MAX_FAILED_JOINS=10
RELAY_FAILED_JOIN_WINDOW_MS=60000
RELAY_ROOM_TTL_MS=600000
RELAY_ROOM_ABSOLUTE_TTL_MS=1800000
