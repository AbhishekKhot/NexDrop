# ============================================================
#  NexDrop — Root Environment Example (Remote-only build)
#  Copy to .env and fill in production values.
#  VITE_* vars are baked into the frontend at build time.
# ============================================================

# ── Frontend (build-time, baked into the static bundle) ───────────────
# Point this at your deployed relay (or ws://localhost:4002 for local dev).
VITE_RELAY_URL=ws://localhost:4002

# ── Relay ─────────────────────────────────────────────────────────────
# `PORT` is also read as a fallback for PaaS hosts (Render, Fly, Heroku).
RELAY_PORT=4002

# 127.0.0.1 when behind a proxy on the same host; 0.0.0.0 inside containers
# or when no proxy fronts the relay.
RELAY_BIND_HOST=127.0.0.1

# REQUIRED in production. Exact origin (scheme + host + optional port).
# Multiple origins comma-separated. No default — fails closed (CWE-352).
RELAY_ALLOWED_ORIGIN=http://localhost:5173

# Trust X-Forwarded-For only behind a known proxy; otherwise it is an IP-
# spoofing vector for the rate limiter (CWE-348).
RELAY_TRUST_PROXY=false

RELAY_MAX_FILE_SIZE=5368709120
RELAY_MAX_CONN_PER_IP=5
RELAY_MAX_MSG_PER_SEC=20
RELAY_MAX_FAILED_JOINS=10
RELAY_FAILED_JOIN_WINDOW_MS=60000
RELAY_ROOM_TTL_MS=600000
RELAY_ROOM_ABSOLUTE_TTL_MS=1800000

# ── Docker Compose ────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── LAN agent (DISABLED) ──────────────────────────────────────────────
# The LAN agent is currently line-commented in backend/src/. These vars
# are inert until you re-enable that code:
#   TCP_PORT=4000
#   WS_API_PORT=4001
#   DEVICE_NAME=nexdrop-node
#   ALLOW_REMOTE_WS=false
#   WS_ALLOWED_ORIGIN=http://localhost:3000
#   DOWNLOAD_DIR=/downloads/NexDrop
#   VITE_AGENT_WS_URL=ws://localhost:4001
