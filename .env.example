# ============================================================
#  NexDrop — Root Environment Example
#  Copy to .env and fill in your production values.
#  All VITE_* vars are baked into the frontend at build time.
# ============================================================

# ── Backend Ports ─────────────────────────────────────────────────────
TCP_PORT=4000
WS_API_PORT=4001
SIGNALING_PORT=4002

# ── Backend Settings ──────────────────────────────────────────────────
DEVICE_NAME=nexdrop-node

# Allow non-localhost WebSocket connections (set true for ngrok/cloudflared)
ALLOW_REMOTE_WS=false

# CORS origin for the WS API (must match frontend URL in production)
WS_ALLOWED_ORIGIN=http://localhost:3000

# Directory where received files are saved inside the backend container
DOWNLOAD_DIR=/downloads/NexDrop

# ── Frontend URL (build-time Vite args) ───────────────────────────────
# In production, replace localhost with your actual server hostname/IP.
# These are injected into the frontend bundle at docker build time.
VITE_AGENT_WS_URL=ws://localhost:4001
VITE_SIGNALING_URL=ws://localhost:4002

# ── ICE / STUN ────────────────────────────────────────────────────────
# Comma-separated STUN server URLs
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ── TURN Server (optional but recommended for production) ─────────────
# Without TURN, ~15% of users behind symmetric NAT cannot connect remotely.
# Free options: https://www.metered.ca/tools/openrelay/
# Self-hosted: https://github.com/coturn/coturn
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ── Signaling Rate Limiting ───────────────────────────────────────────
SIGNALING_MAX_CONN_PER_IP=5
SIGNALING_MAX_MSG_PER_SEC=20
# Room expires (ms) if second peer doesn't join — default 10 minutes
SIGNALING_ROOM_TTL_MS=600000

# ── Docker Compose ────────────────────────────────────────────────────
# Host port the frontend nginx container listens on (non-TLS mode)
FRONTEND_PORT=3000

# ── TLS / Caddy (production) ──────────────────────────────────────────
# Set your domain and run: docker compose --profile tls up --build
# Caddy auto-obtains Let's Encrypt certs; ports 80 and 443 must be open.
# With TLS, set:
#   VITE_SIGNALING_URL=wss://yourdomain.com/signaling
#   WS_ALLOWED_ORIGIN=https://yourdomain.com
NEXDROP_DOMAIN=
