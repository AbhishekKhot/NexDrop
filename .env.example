# ============================================================
#  NexDrop — Root Environment Example
#  Copy to .env and fill in your production values.
#  All VITE_* vars are baked into the frontend at build time.
# ============================================================

# ── Backend Ports ─────────────────────────────────────────────────────
TCP_PORT=4000
WS_API_PORT=4001

# ── Backend Settings ──────────────────────────────────────────────────
DEVICE_NAME=nexdrop-node

# Allow non-localhost WebSocket connections (set true for ngrok/cloudflared)
ALLOW_REMOTE_WS=false

# CORS origin for the WS API (must match frontend URL in production)
WS_ALLOWED_ORIGIN=http://localhost:3000

# Directory where received files are saved inside the backend container (LAN mode)
DOWNLOAD_DIR=/downloads/NexDrop

# ── Frontend URLs (build-time Vite args) ──────────────────────────────
# In production, replace localhost with your actual server hostname/IP.
VITE_AGENT_WS_URL=ws://localhost:4001
# Remote-mode relay URL (wss://relay.your-domain.com in production)
VITE_RELAY_URL=ws://localhost:4002

# ── Remote Relay (deployed separately — see docs/RELAY_PROTOCOL.md) ───
# These apply to the standalone relay process (npm run relay), not the LAN agent.
RELAY_PORT=4002
RELAY_BIND_HOST=127.0.0.1
RELAY_ALLOWED_ORIGIN=http://localhost:5173
RELAY_TRUST_PROXY=false
RELAY_MAX_FILE_SIZE=5368709120
RELAY_MAX_CONN_PER_IP=5
RELAY_MAX_MSG_PER_SEC=20
RELAY_MAX_FAILED_JOINS=10
RELAY_FAILED_JOIN_WINDOW_MS=60000
RELAY_ROOM_TTL_MS=600000
RELAY_ROOM_ABSOLUTE_TTL_MS=1800000

# ── Docker Compose ────────────────────────────────────────────────────
# Host port the frontend nginx container listens on
FRONTEND_PORT=3000
