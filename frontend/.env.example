# ============================================================
#  NexDrop Frontend — Environment Variables
#  Copy to .env for local development.
#  For Docker builds these are passed as build-args (see docker-compose.yml).
# ============================================================

# URL of the local NexDrop agent's WebSocket API
# For ngrok/cloudflared tunnel: wss://your-tunnel.ngrok.io
VITE_AGENT_WS_URL=ws://localhost:4001

# URL of the WebRTC signaling server
# Must be reachable by both peers in Remote mode
VITE_SIGNALING_URL=ws://localhost:4002

# Comma-separated STUN server URLs for WebRTC ICE
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN server — required for ~15% of users behind symmetric NAT
# Sign up: https://www.metered.ca/tools/openrelay/ or self-host coturn
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
