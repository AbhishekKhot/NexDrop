# ============================================================
#  NexDrop Frontend — Environment Variables (Remote-only build)
#  Copy to .env for local development. VITE_* vars are baked
#  in at build time, so rebuild after changes.
# ============================================================

# WebSocket relay URL. Local dev: ws://localhost:4002 (run `npm run dev` in
# backend/ to start the relay). Production: wss://relay.your-domain.com.
VITE_RELAY_URL=ws://localhost:4002

# ── LAN agent (DISABLED) ───────────────────────────────────────────────
# The LAN agent is currently line-commented in backend/src/. Re-enable to
# restore: VITE_AGENT_WS_URL=ws://localhost:4001
