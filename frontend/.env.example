# ============================================================
#  NexDrop Frontend — Environment Variables
#  Copy to .env for local development.
#  For Docker builds these are passed as build-args (see docker-compose.yml).
# ============================================================

# URL of the local NexDrop agent's WebSocket API (used by LAN mode)
# For ngrok/cloudflared tunnel: wss://your-tunnel.ngrok.io
VITE_AGENT_WS_URL=ws://localhost:4001

# URL of the Remote-mode relay (used by Remote mode).
# Local dev: ws://localhost:4002 (run `npm run relay:dev` in backend/).
# Production: wss://relay.your-domain.com
VITE_RELAY_URL=ws://localhost:4002
