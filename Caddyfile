# ============================================================
#  NexDrop — Caddyfile
#
#  Caddy handles automatic HTTPS (Let's Encrypt) in production.
#  For local dev with self-signed certs, set NEXDROP_DOMAIN=localhost
#  (Caddy will use its internal CA automatically for localhost).
#
#  Usage:
#    1. Set NEXDROP_DOMAIN in your .env (e.g. nexdrop.example.com)
#    2. Ensure ports 80 and 443 are reachable from the internet
#       (required for Let's Encrypt HTTP-01 challenge)
#    3. docker compose --profile tls up --build
#
#  Routing:
#    /signaling*  → WebRTC signaling WebSocket  (backend:4002)
#    /*           → Frontend SPA                (frontend:80)
#
#  Note: The WS API (backend:4001) is NOT exposed through Caddy.
#  It is localhost-only and accessed by the native agent directly.
# ============================================================

{$NEXDROP_DOMAIN:localhost} {

    # WebRTC signaling WebSocket — path-based routing
    # Frontend connects to wss://yourdomain/signaling
    handle /signaling* {
        reverse_proxy backend:4002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend SPA (catch-all)
    handle {
        reverse_proxy frontend:80 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Allow WebRTC APIs (camera/mic not needed, but keep CSP permissive for WS/WebRTC)
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss: ws:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
    }

    log {
        output stdout
        format console
        level INFO
    }
}
